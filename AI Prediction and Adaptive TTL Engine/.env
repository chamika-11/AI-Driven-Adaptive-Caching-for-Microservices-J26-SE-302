# ─────────────────────────────────────────────────────────────────────────────
# Component 1: Adaptive TTL Engine — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── TTL Bounds (seconds) ─────────────────────────────────────────────────────
MIN_TTL=10
MAX_TTL=3600
DEFAULT_TTL=300

# ── API Server ───────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5001
DEBUG=false

# ── Paths (leave blank to use defaults relative to project root) ──────────────
# MODEL_DIR=/app/models
# DATA_DIR=/app/data

# ── Hot-Key Detector ─────────────────────────────────────────────────────────
HOTKEY_THRESHOLD=1000
HOTKEY_WINDOW_SECONDS=60

# ── Volatility Engine ────────────────────────────────────────────────────────
EWMA_ALPHA=0.3

# ── LSTM Training ────────────────────────────────────────────────────────────
SEQUENCE_LENGTH=60
LSTM_EPOCHS=30
LSTM_BATCH_SIZE=32
TRAIN_SPLIT=0.7

# ── Retraining / Rollback Gate ───────────────────────────────────────────────
# New model is rejected if its RMSE is more than this % worse than the old one
ROLLBACK_TOLERANCE=0.05
