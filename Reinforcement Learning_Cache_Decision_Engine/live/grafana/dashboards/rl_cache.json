  {
   "id": 8,
   "type": "table",
   "title": "Decision log: what the model chose for the latest cache misses (newest first)",
   "description": "Each row is one cache miss. The model read the 19 inputs and picked where to store the item, how long to keep it (TTL) and its eviction priority. q_score = how good the model thinks this action is; confidence = share of the top action.",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "rlcache_recent_decision{policy=\"agent (RL model)\"} == on(policy) group_left rlcache_recent_batch{policy=\"agent (RL model)\"}",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "seq",
        "destinationType": "number"
       },
       {
        "targetField": "key",
        "destinationType": "number"
       },
       {
        "targetField": "size_bytes",
        "destinationType": "number"
       },
       {
        "targetField": "ttl_s",
        "destinationType": "number"
       }
      ]
     }
    },
    {
     "id": "sortBy",
     "options": {
      "fields": {},
      "sort": [
       {
        "field": "seq",
        "desc": true
       }
      ]
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "batch": true,
       "policy": true,
       "choice": true
      },
      "indexByName": {
       "seq": 0,
       "sim_time": 1,
       "key": 2,
       "size_bytes": 3,
       "placement": 4,
       "ttl_s": 5,
       "priority": 6,
       "q_score": 7,
       "confidence": 8
      },
      "renameByName": {
       "seq": "#",
       "sim_time": "sim time (m:ss)",
       "key": "key id",
       "size_bytes": "size (bytes)",
       "placement": "store in",
       "ttl_s": "keep for (s)",
       "priority": "eviction priority",
       "q_score": "score (Q)",
       "confidence": "confidence"
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "left"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
