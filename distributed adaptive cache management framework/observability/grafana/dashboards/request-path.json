    {
      "id": 9,
      "title": "Local cache entries",
      "description": "Current in-process entries; periodic maintenance removes expired entries.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cache-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "cache_state{job=\"prototype\",instance=\"sidecar:8081\",kind=\"local_entries\"}",
          "legendFormat": "Local cache entries",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cache-prometheus"
          }
