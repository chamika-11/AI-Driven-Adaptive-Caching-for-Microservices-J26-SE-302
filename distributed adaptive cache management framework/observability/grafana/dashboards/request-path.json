    {
      "id": 10,
      "title": "Go heap usage by service",
      "description": "Live Go heap allocations. This is not Redis or PostgreSQL memory.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cache-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_memstats_heap_alloc_bytes{job=\"prototype\"}",
