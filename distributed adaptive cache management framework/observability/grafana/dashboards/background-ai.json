      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(cache_events_total{job=\"prototype\",instance=\"workflow:8082\",kind=\"workflow_call\"}[1m]))) or (0 * max(up{job=\"prototype\",instance=\"workflow:8082\"} == 1))",
          "legendFormat": "Workflow calls / second",
          "range": true,
          "editorMode": "code",
