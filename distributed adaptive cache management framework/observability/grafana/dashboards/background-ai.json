{
  "uid": "cache-background",
  "title": "2. Background AI — batches and TTL policies",
  "tags": [
    "adaptive-cache",
    "demo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "1. Request path",
      "url": "/d/cache-request-path",
      "type": "link"
    },
    {
      "title": "2. Background AI",
      "url": "/d/cache-background",
      "type": "link"
    },
    {
      "title": "Prometheus targets",
      "url": "http://localhost:9090/targets",
      "type": "link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Analysis batches / second",
      "description": "A batch is created after 100 accesses or the 5-second timer by default.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cache-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(cache_events_total{job=\"prototype\",instance=\"sidecar:8081\",kind=\"batch_created\"}[1m]))) or (0 * max(up{job=\"prototype\",instance=\"sidecar:8081\"} == 1))",
          "legendFormat": "Analysis batches / second",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cache-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
