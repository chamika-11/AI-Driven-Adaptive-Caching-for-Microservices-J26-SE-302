    {
      "id": 5,
      "title": "AI job duration — p95 (ms)",
      "description": "Worker duration includes workflow calls, retry/backoff and policy application. It is not model inference time alone.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cache-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95,sum by(le)(rate(ai_processing_seconds_bucket{job=\"prototype\",instance=\"sidecar:8081\"}[1m])))",
          "legendFormat": "AI job duration — p95 (ms)",
          "range": true,
          "editorMode": "code",
          "datasource": {
            "type": "prometheus",
            "uid": "cache-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
