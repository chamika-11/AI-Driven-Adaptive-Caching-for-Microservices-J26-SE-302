{
  "name": "@component4/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript types, schemas, and data contracts for Component 4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rimraf dist *.tsbuildinfo",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "rimraf": "~6.0.1",
    "vitest": "~2.1.3"
  }
}
