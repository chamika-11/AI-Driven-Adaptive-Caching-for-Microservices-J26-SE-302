# ──────────────────────────────────────────────
# Component 4 — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
API_PORT=4004
API_HOST=0.0.0.0

# Frontend
# Leave unset in development — Vite proxies /api/* to localhost:4004 automatically.
# Set to the deployed API URL in production (e.g. https://api.example.com).
# VITE_API_BASE_URL=http://localhost:4004

# MongoDB Atlas (Required for backend startup)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/event_intelligence?retryWrites=true&w=majority

# MongoDB Atlas Test Database (Dedicated for Part 2.4 integration tests; MUST target a test DB like component4_test)
MONGODB_TEST_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/component4_test?retryWrites=true&w=majority
TEST_LIVE_ATLAS=false

# Logging
LOG_LEVEL=debug

