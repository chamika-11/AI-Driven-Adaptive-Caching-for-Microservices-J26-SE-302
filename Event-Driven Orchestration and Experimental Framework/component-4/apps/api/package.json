  },
  "devDependencies": {
    "@component4/shared": "*",
    "typescript": "~5.6.3",
    "tsx": "~4.19.1",
    "vitest": "~2.1.3",
    "@types/express": "~5.0.0",
    "@types/cors": "~2.8.17",
    "@types/node": "~22.7.5",
    "rimraf": "~6.0.1",
    "supertest": "~7.0.0",
    "@types/supertest": "~6.0.2"
  }
}
