{
  "name": "@component4/api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Component 4 — Event Intelligence & Context-Aware Feature Engineering",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
