{
  "name": "component-4-event-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Event Intelligence & Context-Aware Feature Engineering — Component 4 monorepo",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=apps/api",
    "test:unit": "npm run test:unit --workspace=apps/api",
    "test:integration": "npm run test:integration --workspace=apps/api",
    "test:shared": "npm run test --workspace=packages/shared",
    "test:ingestion": "cd services/ingestion && \"%USERPROFILE%\\.c4_venv\\Scripts\\pytest.exe\" -v",
    "dev:ingestion": "cd services/ingestion && \"%USERPROFILE%\\.c4_venv\\Scripts\\python.exe\" -m uvicorn src.main:app --host 0.0.0.0 --port 8001 --reload",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
