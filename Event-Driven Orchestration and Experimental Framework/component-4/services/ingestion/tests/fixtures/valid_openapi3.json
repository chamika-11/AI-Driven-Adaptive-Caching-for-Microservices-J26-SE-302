{
  "openapi": "3.0.3",
  "info": {
    "title": "Order Management Service",
    "version": "1.4.0",
    "description": "Microservice for managing customer orders and transactions."
  },
  "servers": [
    { "url": "https://api.orders.example.com/v1" }
  ],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List all customer orders",
        "description": "Retrieves paginated orders matching search parameters.",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by order status",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "List of orders returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Order" }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Create a new order",
        "tags": ["Orders"],
        "requestBody": {
          "required": true,
          "description": "Order creation payload",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/orders/{orderId}": {
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "description": "Order unique identifier",
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "operationId": "getOrderById",
        "summary": "Get order by ID",
        "tags": ["Orders"],
        "responses": {
          "200": {
            "description": "Order found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "404": {
            "description": "Order not found"
          }
        }
      },
      "delete": {
        "operationId": "cancelOrder",
        "summary": "Cancel an existing order",
        "tags": ["Orders"],
        "responses": {
          "204": {
            "description": "Order cancelled"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "number" }
        }
      },
      "CreateOrderInput": {
        "type": "object",
        "properties": {
          "amount": { "type": "number" }
        }
      }
    }
  }
}
